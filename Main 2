#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_MEMBERS 200
#define NAME_LEN 50

/* =========================================
   MEMBER STRUCTURE
   ========================================= */

typedef struct {

    unsigned int id;

    char name[NAME_LEN];

    char plan_type[15];

    char join_date[11];

    char expiry_date[11];

    int active;

} Member;


/* =========================================
   GLOBAL VARIABLES
   ========================================= */

Member members[MAX_MEMBERS];

int member_count = 0;


/* =========================================
   GET PLAN PRICE
   ========================================= */

float get_plan_price(char plan[]) {

    if (strcmp(plan, "Basic") == 0) {

        return 1000.0;

    }

    else if (strcmp(plan, "Standard") == 0) {

        return 1500.0;

    }

    else if (strcmp(plan, "Premium") == 0) {

        return 2000.0;

    }

    return 0.0;
}


/* =========================================
   GET NUMBER OF DAYS IN A MONTH
   ========================================= */

int days_in_month(int month, int year) {

    if (month == 2) {

        /* Leap year */

        if ((year % 400 == 0) ||
            (year % 4 == 0 && year % 100 != 0)) {

            return 29;
        }

        return 28;
    }

    if (month == 4 ||
        month == 6 ||
        month == 9 ||
        month == 11) {

        return 30;
    }

    return 31;
}


/* =========================================
   VALIDATE DATE
   Format: DD/MM/YYYY
   ========================================= */

int valid_date(char date[]) {

    int day;
    int month;
    int year;

    /*
       Convert date string into
       day, month and year
    */

    if (sscanf(date,
               "%d/%d/%d",
               &day,
               &month,
               &year) != 3) {

        return 0;
    }


    /* Validate year */

    if (year < 2000 || year > 2100) {

        return 0;
    }


    /* Validate month */

    if (month < 1 || month > 12) {

        return 0;
    }


    /* Validate day */

    if (day < 1 ||
        day > days_in_month(month, year)) {

        return 0;
    }


    return 1;
}


/* =========================================
   GET TODAY'S DATE
   Format: DD/MM/YYYY
   ========================================= */

void get_today(char today[]) {

    time_t t;

    struct tm *current;


    /* Get current system time */

    t = time(NULL);


    /* Convert time to local date/time */

    current = localtime(&t);


    /*
       Store today's date
       in DD/MM/YYYY format
    */

    sprintf(today,
            "%02d/%02d/%04d",
            current->tm_mday,
            current->tm_mon + 1,
            current->tm_year + 1900);
}


/* =========================================
   CONVERT DATE TO TOTAL DAYS
   ========================================= */

long date_to_days(char date[]) {

    int day;
    int month;
    int year;

    long total = 0;


    /*
       Extract date
    */

    sscanf(date,
           "%d/%d/%d",
           &day,
           &month,
           &year);


    /*
       Add days from previous years
    */

    for (int y = 1; y < year; y++) {

        total += 365;


        /*
           Check leap year
        */

        if ((y % 400 == 0) ||
            (y % 4 == 0 && y % 100 != 0)) {

            total++;
        }
    }


    /*
       Add days from previous months
    */

    for (int m = 1; m < month; m++) {

        total += days_in_month(m, year);
    }


    /*
       Add current day
    */

    total += day;


    return total;
}


/* =========================================
   COMPARE TWO DATES
   ========================================= */

int compare_dates(char date1[], char date2[]) {

    long d1;
    long d2;


    d1 = date_to_days(date1);

    d2 = date_to_days(date2);


    if (d1 < d2) {

        return -1;
    }

    else if (d1 > d2) {

        return 1;
    }


    return 0;
}


/* =========================================
   ADD MONTHS TO A DATE
   ========================================= */

void add_months(char date[],
                int months,
                char result[]) {

    int day;
    int month;
    int year;


    /*
       Extract date
    */

    sscanf(date,
           "%d/%d/%d",
           &day,
           &month,
           &year);


    /*
       Add months
    */

    month = month + months;


    /*
       Convert extra months into years
    */

    while (month > 12) {

        month = month - 12;

        year++;
    }


    /*
       Get maximum number of days
       in the new month
    */

    int max_day =
        days_in_month(month, year);


    /*
       Example:

       31/01/2026 + 1 month

       becomes

       28/02/2026
    */

    if (day > max_day) {

        day = max_day;
    }


    /*
       Create new date
    */

    sprintf(result,
            "%02d/%02d/%04d",
            day,
            month,
            year);
}


/* =========================================
   SAVE DATA
   ========================================= */

void save_data() {

    FILE *file;


    /*
       Open file in binary write mode
    */

    file = fopen("members.dat", "wb");


    if (file == NULL) {

        printf("\nError: Could not save data!\n");

        return;
    }


    /*
       Save member count
    */

    fwrite(&member_count,
           sizeof(int),
           1,
           file);


    /*
       Save members
    */

    fwrite(members,
           sizeof(Member),
           member_count,
           file);


    fclose(file);
}


/* =========================================
   LOAD DATA
   AND AUTOMATICALLY CHECK EXPIRY
   ========================================= */

void load_data() {

    FILE *file;


    /*
       Open saved data
    */

    file = fopen("members.dat", "rb");


    /*
       If file doesn't exist,
       there are no saved members.
    */

    if (file == NULL) {

        return;
    }


    /*
       Read member count
    */

    fread(&member_count,
          sizeof(int),
          1,
          file);


    /*
       Safety check
    */

    if (member_count < 0 ||
        member_count > MAX_MEMBERS) {

        member_count = 0;

        fclose(file);

        return;
    }


    /*
       Read all members
    */

    fread(members,
          sizeof(Member),
          member_count,
          file);


    fclose(file);


    /*
       Get today's date automatically
    */

    char today[11];

    get_today(today);


    int changed = 0;


    /*
       Check every member
    */

    for (int i = 0;
         i < member_count;
         i++) {


        /*
           If expiry date is before today,
           membership has expired.
        */

        if (compare_dates(
                members[i].expiry_date,
                today) < 0) {


            /*
               Change active member
               into inactive member.
            */

            if (members[i].active == 1) {

                members[i].active = 0;

                changed = 1;
            }
        }
    }


    /*
       Save updated status
    */

    if (changed) {

        save_data();
    }
}


/* =========================================
   REGISTER MEMBER
   ========================================= */

void register_member() {

    /*
       Check member limit
    */

    if (member_count >= MAX_MEMBERS) {

        printf("\nMember limit reached!\n");

        return;
    }


    Member new_member;


    printf("\n");
    printf("=====================================\n");
    printf("          REGISTER MEMBER\n");
    printf("=====================================\n");


    /*
       Generate member ID
    */

    new_member.id =
        member_count + 1;


    /*
       Input member name
    */

    printf("Enter member name: ");

    getchar();

    fgets(new_member.name,
          NAME_LEN,
          stdin);


    /*
       Remove newline
    */

    new_member.name[
        strcspn(new_member.name, "\n")
    ] = '\0';


    /*
       Display plans
    */

    printf("\nAvailable Plans:\n");

    printf("1. Basic    - 1000 BDT/month\n");

    printf("2. Standard - 1500 BDT/month\n");

    printf("3. Premium  - 2000 BDT/month\n");


    int choice;


    printf("\nChoose plan: ");

    scanf("%d", &choice);


    /*
       Select plan
    */

    if (choice == 1) {

        strcpy(new_member.plan_type,
               "Basic");
    }

    else if (choice == 2) {

        strcpy(new_member.plan_type,
               "Standard");
    }

    else if (choice == 3) {

        strcpy(new_member.plan_type,
               "Premium");
    }

    else {

        printf("\nInvalid plan!\n");

        return;
    }


    /*
       Enter join date
    */

    do {

        printf("Enter join date (DD/MM/YYYY): ");

        scanf("%10s",
              new_member.join_date);


        if (!valid_date(
                new_member.join_date)) {

            printf("Invalid date! Try again.\n");
        }

    } while (!valid_date(
                new_member.join_date));


    /*
       Initial membership is one month
    */

    add_months(
        new_member.join_date,
        1,
        new_member.expiry_date);


    /*
       New member is active
    */

    new_member.active = 1;


    /*
       Add member to array
    */

    members[member_count] =
        new_member;


    member_count++;


    /*
       Save data
    */

    save_data();


    /*
       Display registration result
    */

    printf("\n");
    printf("Member registered successfully!\n");

    printf("-------------------------------------\n");

    printf("Member ID    : %u\n",
           new_member.id);

    printf("Name         : %s\n",
           new_member.name);

    printf("Plan         : %s\n",
           new_member.plan_type);

    printf("Join Date    : %s\n",
           new_member.join_date);

    printf("Expiry Date  : %s\n",
           new_member.expiry_date);

    printf("Monthly Fee  : %.2f BDT\n",
           get_plan_price(
               new_member.plan_type));

    printf("-------------------------------------\n");
}


/* =========================================
   FIND MEMBER BY ID
   ========================================= */

int find_member(unsigned int id) {

    /*
       Search all members
    */

    for (int i = 0;
         i < member_count;
         i++) {


        if (members[i].id == id) {

            return i;
        }
    }


    /*
       Member not found
    */

    return -1;
}


/* =========================================
   RENEW MEMBERSHIP
   ========================================= */

void renew_membership() {

    unsigned int id;


    printf("\n");
    printf("=====================================\n");
    printf("          RENEW MEMBERSHIP\n");
    printf("=====================================\n");


    /*
       Enter member ID
    */

    printf("Enter member ID: ");

    scanf("%u", &id);


    /*
       Find member
    */

    int index =
        find_member(id);


    /*
       Check member
    */

    if (index == -1) {

        printf("\nMember not found!\n");

        return;
    }


    int months;


    /*
       Enter renewal duration
    */

    printf("Enter number of months to renew: ");

    scanf("%d", &months);


    /*
       Validate months
    */

    if (months <= 0) {

        printf("\nInvalid number of months!\n");

        return;
    }


    char start_date[11];

    char today[11];


    /*
       Get today's date
    */

    get_today(today);


    /*
       If membership has expired,
       renewal starts today.
    */

    if (compare_dates(
            members[index].expiry_date,
            today) < 0) {

        strcpy(start_date,
               today);
    }

    else {

        /*
           If still active,
           renewal starts from
           existing expiry date.
        */

        strcpy(start_date,
               members[index].expiry_date);
    }


    /*
       Calculate new expiry date
    */

    add_months(
        start_date,
        months,
        members[index].expiry_date);


    /*
       Activate membership
    */

    members[index].active = 1;


    /*
       Save data
    */

    save_data();


    /*
       Calculate renewal cost
    */

    float renewal_cost =
        get_plan_price(
            members[index].plan_type)
        * months;


    /*
       Display result
    */

    printf("\n");
    printf("Membership renewed successfully!\n");

    printf("-------------------------------------\n");

    printf("Member       : %s\n",
           members[index].name);

    printf("Plan         : %s\n",
           members[index].plan_type);

    printf("Months       : %d\n",
           months);

    printf("New Expiry   : %s\n",
           members[index].expiry_date);

    printf("Renewal Cost : %.2f BDT\n",
           renewal_cost);

    printf("-------------------------------------\n");
}


/* =========================================
   CHECK EXPIRED MEMBERS
   ========================================= */

void check_expired() {

    char today[11];


    printf("\n");
    printf("=====================================\n");
    printf("       CHECK EXPIRED MEMBERS\n");
    printf("=====================================\n");


    /*
       Get current system date
    */

    get_today(today);


    printf("Today's Date: %s\n",
           today);


    int expired_count = 0;


    /*
       Check all members
    */

    for (int i = 0;
         i < member_count;
         i++) {


        /*
           Compare expiry with today
        */

        if (compare_dates(
                members[i].expiry_date,
                today) < 0) {


            if (members[i].active == 1) {

                members[i].active = 0;

                expired_count++;
            }
        }
    }


    /*
       Save changes
    */

    save_data();


    printf("\nExpired memberships updated.\n");

    printf("Newly expired members: %d\n",
           expired_count);
}


/* =========================================
   ATTENDANCE CHECK-IN
   ========================================= */

void attendance_checkin() {

    unsigned int id;


    printf("\n");
    printf("=====================================\n");
    printf("         ATTENDANCE CHECK-IN\n");
    printf("=====================================\n");


    /*
       Enter member ID
    */

    printf("Enter member ID: ");

    scanf("%u", &id);


    /*
       Find member
    */

    int index =
        find_member(id);


    /*
       Check member exists
    */

    if (index == -1) {

        printf("\nMember not found!\n");

        return;
    }


    /*
       Check membership status
    */

    if (members[index].active == 0) {

        printf("\nMembership expired/inactive!\n");

        printf("Check-in denied.\n");

        return;
    }


    /*
       Successful check-in
    */

    printf("\nCheck-in successful!\n");

    printf("Member: %s\n",
           members[index].name);

    printf("Plan: %s\n",
           members[index].plan_type);
}


/* =========================================
   REVENUE REPORT
   ========================================= */

void revenue_report() {

    float total = 0.0;

    int basic = 0;

    int standard = 0;

    int premium = 0;


    printf("\n");
    printf("=====================================\n");
    printf("           REVENUE REPORT\n");
    printf("=====================================\n");


    /*
       Check whether members exist
    */

    if (member_count == 0) {

        printf("\nNo members registered.\n");

        return;
    }


    /*
       Count members according to
       their membership plans.
    */

    for (int i = 0;
         i < member_count;
         i++) {


        /*
           Basic plan
        */

        if (strcmp(
                members[i].plan_type,
                "Basic") == 0) {

            basic++;

            total += 1000.0;
        }


        /*
           Standard plan
        */

        else if (strcmp(
                     members[i].plan_type,
                     "Standard") == 0) {

            standard++;

            total += 1500.0;
        }


        /*
           Premium plan
        */

        else if (strcmp(
                     members[i].plan_type,
                     "Premium") == 0) {

            premium++;

            total += 2000.0;
        }
    }


    /*
       Display plan information
    */

    printf("\n");
    printf("---------- PLAN DETAILS ----------\n");

    printf("Basic Members     : %d\n",
           basic);

    printf("Standard Members  : %d\n",
           standard);

    printf("Premium Members   : %d\n",
           premium);


    /*
       Display revenue
    */

    printf("\n");
    printf("---------- REVENUE ----------\n");


    printf("Basic Revenue     : %.2f BDT\n",
           basic * 1000.0);


    printf("Standard Revenue  : %.2f BDT\n",
           standard * 1500.0);


    printf("Premium Revenue   : %.2f BDT\n",
           premium * 2000.0);


    printf("-------------------------------------\n");


    printf("Total Revenue     : %.2f BDT\n",
           total);


    printf("=====================================\n");
}


/* =========================================
   DISPLAY ALL MEMBERS
   ========================================= */

void display_members() {

    printf("\n");
    printf("=====================================\n");
    printf("            ALL MEMBERS\n");
    printf("=====================================\n");


    /*
       Check if there are members
    */

    if (member_count == 0) {

        printf("\nNo members found.\n");

        return;
    }


    /*
       Display every member
    */

    for (int i = 0;
         i < member_count;
         i++) {


        printf("\n");
        printf("-------------------------------------\n");


        printf("ID           : %u\n",
               members[i].id);


        printf("Name         : %s\n",
               members[i].name);


        printf("Plan         : %s\n",
               members[i].plan_type);


        printf("Join Date    : %s\n",
               members[i].join_date);


        printf("Expiry Date  : %s\n",
               members[i].expiry_date);


        /*
           Display membership status
        */

        if (members[i].active == 1) {

            printf("Status       : ACTIVE\n");
        }

        else {

            printf("Status       : EXPIRED/INACTIVE\n");
        }
    }


    printf("-------------------------------------\n");
}


