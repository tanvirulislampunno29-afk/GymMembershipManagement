#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_MEMBERS 200
#define NAME_LEN 50

typedef struct {
    unsigned int id;
    char name[NAME_LEN];
    char plan_type[15];
    char join_date[11];
    char expiry_date[11];
    int active;
} Member;

Member members[MAX_MEMBERS];
int member_count = 0;

/* Plan prices */
float get_plan_price(char plan[]) {
    if (strcmp(plan, "Basic") == 0)
        return 1000.0;
    else if (strcmp(plan, "Standard") == 0)
        return 1500.0;
    else if (strcmp(plan, "Premium") == 0)
        return 2000.0;

    return 0.0;
}

/* Number of days in a month */
int days_in_month(int month, int year) {
    if (month == 2) {
        if ((year % 400 == 0) || (year % 4 == 0 && year % 100 != 0))
            return 29;
        return 28;
    }

    if (month == 4 || month == 6 || month == 9 || month == 11)
        return 30;

    return 31;
}

/* Validate date in DD/MM/YYYY format */
int valid_date(char date[]) {
    int day, month, year;

    if (sscanf(date, "%d/%d/%d", &day, &month, &year) != 3)
        return 0;

    if (year < 2000 || year > 2100)
        return 0;

    if (month < 1 || month > 12)
        return 0;

    if (day < 1 || day > days_in_month(month, year))
        return 0;

    return 1;
}

/* Convert date to number of days */
long date_to_days(char date[]) {
    int d, m, y;
    sscanf(date, "%d/%d/%d", &d, &m, &y);

    long total = 0;

    for (int year = 1; year < y; year++) {
        total += 365;

        if ((year % 400 == 0) ||
            (year % 4 == 0 && year % 100 != 0))
            total++;
    }

    for (int month = 1; month < m; month++)
        total += days_in_month(month, y);

    total += d;

    return total;
}

/* Compare two dates */
int compare_dates(char date1[], char date2[]) {
    long d1 = date_to_days(date1);
    long d2 = date_to_days(date2);

    if (d1 < d2)
        return -1;
    else if (d1 > d2)
        return 1;

    return 0;
}

/* Add months to a date */
void add_months(char date[], int months, char result[]) {
    int day, month, year;

    sscanf(date, "%d/%d/%d", &day, &month, &year);

    month += months;

    while (month > 12) {
        month -= 12;
        year++;
    }

    int max_day = days_in_month(month, year);

    if (day > max_day)
        day = max_day;

    sprintf(result, "%02d/%02d/%04d", day, month, year);
}

/* Save members to file */
void save_data() {
    FILE *file = fopen("members.dat", "wb");

    if (file == NULL) {
        printf("Error saving data!\n");
        return;
    }

    fwrite(&member_count, sizeof(int), 1, file);
    fwrite(members, sizeof(Member), member_count, file);

    fclose(file);
}

/* Load members from file */
void load_data() {
    FILE *file = fopen("members.dat", "rb");

    if (file == NULL)
        return;

    fread(&member_count, sizeof(int), 1, file);
    fread(members, sizeof(Member), member_count, file);

    fclose(file);
}

/* Register a new member */
void register_member() {
    if (member_count >= MAX_MEMBERS) {
        printf("\nMember limit reached!\n");
        return;
    }

    Member new_member;

    printf("\n===== REGISTER MEMBER =====\n");

    new_member.id = member_count + 1;

    printf("Enter member name: ");
    getchar();
    fgets(new_member.name, NAME_LEN, stdin);
    new_member.name[strcspn(new_member.name, "\n")] = '\0';

    printf("\nAvailable Plans:\n");
    printf("1. Basic    - 1000/month\n");
    printf("2. Standard - 1500/month\n");
    printf("3. Premium  - 2000/month\n");

    int choice;

    printf("Choose plan: ");
    scanf("%d", &choice);

    if (choice == 1)
        strcpy(new_member.plan_type, "Basic");
    else if (choice == 2)
        strcpy(new_member.plan_type, "Standard");
    else if (choice == 3)
        strcpy(new_member.plan_type, "Premium");
    else {
        printf("Invalid plan!\n");
        return;
    }

    do {
        printf("Enter join date (DD/MM/YYYY): ");
        scanf("%10s", new_member.join_date);

        if (!valid_date(new_member.join_date))
            printf("Invalid date! Try again.\n");

    } while (!valid_date(new_member.join_date));

    /* Membership lasts one month */
    add_months(new_member.join_date, 1, new_member.expiry_date);

    new_member.active = 1;

    members[member_count] = new_member;
    member_count++;

    save_data();

    printf("\nMember registered successfully!\n");
    printf("Member ID: %u\n", new_member.id);
    printf("Plan: %s\n", new_member.plan_type);
    printf("Expiry Date: %s\n", new_member.expiry_date);
    printf("Monthly Fee: %.2f\n", get_plan_price(new_member.plan_type));
}

/* Find member by ID */
int find_member(unsigned int id) {
    for (int i = 0; i < member_count; i++) {
        if (members[i].id == id)
            return i;
    }

    return -1;
}

/* Renew membership */
void renew_membership() {
    unsigned int id;

    printf("\n===== RENEW MEMBERSHIP =====\n");

    printf("Enter member ID: ");
    scanf("%u", &id);

    int index = find_member(id);

    if (index == -1) {
        printf("Member not found!\n");
        return;
    }

    int months;

    printf("Enter number of months to renew: ");
    scanf("%d", &months);

    if (months <= 0) {
        printf("Invalid number of months!\n");
        return;
    }

    char start_date[11];

    /*
       If membership is already expired,
       renewal starts from today's entered date.
       For simplicity, we use the current expiry date
       if it has not expired.
    */

    strcpy(start_date, members[index].expiry_date);

    add_months(start_date, months, members[index].expiry_date);

    members[index].active = 1;

    save_data();

    printf("\nMembership renewed successfully!\n");
    printf("New expiry date: %s\n", members[index].expiry_date);

    printf("Renewal cost: %.2f\n",
           get_plan_price(members[index].plan_type) * months);
}

/* Check expired memberships */
void check_expired() {
    char today[11];

    printf("\n===== CHECK EXPIRED MEMBERS =====\n");

    do {
        printf("Enter today's date (DD/MM/YYYY): ");
        scanf("%10s", today);

        if (!valid_date(today))
            printf("Invalid date!\n");

    } while (!valid_date(today));

    int expired_count = 0;

    for (int i = 0; i < member_count; i++) {

        if (compare_dates(members[i].expiry_date, today) < 0) {
            members[i].active = 0;
            expired_count++;
        }
    }

    save_data();

    printf("\nExpired memberships updated.\n");
    printf("Expired members: %d\n", expired_count);
}

/* Attendance check-in */
void attendance_checkin() {
    unsigned int id;

    printf("\n===== ATTENDANCE CHECK-IN =====\n");

    printf("Enter member ID: ");
    scanf("%u", &id);

    int index = find_member(id);

    if (index == -1) {
        printf("Member not found!\n");
        return;
    }

    if (members[index].active == 0) {
        printf("Membership expired! Check-in denied.\n");
        return;
    }

    printf("\nCheck-in successful!\n");
    printf("Member: %s\n", members[index].name);
    printf("Plan: %s\n", members[index].plan_type);
}

/* Revenue report */
void revenue_report() {
    float total = 0;

    printf("\n===== REVENUE REPORT =====\n");

    if (member_count == 0) {
        printf("No members registered.\n");
        return;
    }

    for (int i = 0; i < member_count; i++) {
        total += get_plan_price(members[i].plan_type);
    }

    printf("Total Members: %d\n", member_count);
    printf("Basic Members: ");

    int basic = 0, standard = 0, premium = 0;

    for (int i = 0; i < member_count; i++) {
        if (strcmp(members[i].plan_type, "Basic") == 0)
            basic++;
        else if (strcmp(members[i].plan_type, "Standard") == 0)
            standard++;
        else if (strcmp(members[i].plan_type, "Premium") == 0)
            premium++;
    }

    printf("%d\n", basic);

    printf("Standard Members: %d\n", standard);
    printf("Premium Members: %d\n", premium);

    printf("\nEstimated Monthly Revenue: %.2f\n", total);
}

/* Display all members */
void display_members() {
    printf("\n===== ALL MEMBERS =====\n");

    if (member_count == 0) {
        printf("No members found.\n");
        return;
    }

    for (int i = 0; i < member_count; i++) {
        printf("\nID: %u\n", members[i].id);
        printf("Name: %s\n", members[i].name);
        printf("Plan: %s\n", members[i].plan_type);
        printf("Join Date: %s\n", members[i].join_date);
        printf("Expiry Date: %s\n", members[i].expiry_date);

        if (members[i].active)
            printf("Status: ACTIVE\n");
        else
            printf("Status: EXPIRED/INACTIVE\n");
    }
}

/* Main menu */
int main() {
    int choice;

    load_data();

    printf("=====================================\n");
    printf("           DAFFODIL GYM              \n");
    printf("      GYM MEMBERSHIP MANAGEMENT      \n");
    printf("=====================================\n");
    do {
        printf("\n========== MAIN MENU ==========\n");
        printf("1. Register Member\n");
        printf("2. Renew Membership\n");
        printf("3. Check Expired Members\n");
        printf("4. Attendance Check-in\n");
        printf("5. Revenue Report\n");
        printf("6. Display All Members\n");
        printf("0. Exit\n");
        printf("===============================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                register_member();
                break;

            case 2:
                renew_membership();
                break;

            case 3:
                check_expired();
                break;

            case 4:
                attendance_checkin();
                break;

            case 5:
                revenue_report();
                break;

            case 6:
                display_members();
                break;

            case 0:
                printf("\nThank you for using Gym Membership Management System!\n");
                break;

            default:
                printf("\nInvalid choice! Try again.\n");
        }

    } while (choice != 0);

    return 0;
}
